<h1><%= @kukai.title %></h1>

<h2>お題</h2>
  <ul>
    <% @keywords.each do |k| %>
      <li><%= link_to k.word, kukai_keyword_path(@kukai, k) %></li>
    <% end %>
  </ul>

<h2>投稿する</h2>

  <%= form_with model: [@kukai, Post.new], local: true do |f| %>
    <div>
      <%= f.label :keyword_id, "お題" %>
      <%= f.collection_select :keyword_id, @keywords, :id, :word, prompt: "選択してください" %>
    </div>

    <div>
      <%= f.label :verse, "川柳" %>
      <%= f.text_field :verse %>
    </div>

    <div>
      <%= f.submit "投稿する" %>
    </div>
  <% end %>

<h2>新着投稿</h2>
  <% if @posts.any? %>
    <%= render @posts %>
  <% else %>
    <p>まだ投稿がありません。</p>
  <% end %>
