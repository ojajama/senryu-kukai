<% content_for :title, "句会を編集 - #{@kukai.title}" %>
<section class="auth-panel">
  <div class="section-heading">
    <h1>句会を編集</h1>
  </div>

  <%= form_with model: [:admin, @kukai], class: "auth-form" do |f| %>
    <% if @kukai.errors.any? %>
      <div class="form-errors">
        <p>句会を保存できませんでした。</p>
        <ul>
          <% @kukai.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-row">
      <%= f.label :title, "タイトル" %>
      <%= f.text_field :title, autofocus: true %>
    </div>

    <div class="form-row two-columns">
      <div>
        <%= f.label :year, "年" %>
        <%= f.number_field :year, min: 2000, max: 2100 %>
      </div>
      <div>
        <%= f.label :month, "月" %>
        <%= f.number_field :month, min: 1, max: 12 %>
      </div>
    </div>

    <label class="checkbox-row">
      <%= f.check_box :visible %>
      <span>句会一覧とトップページに表示する</span>
    </label>

    <div class="form-actions">
      <%= link_to "戻る", admin_kukais_path, class: "secondary-link" %>
      <%= f.submit "更新する", class: "primary-button" %>
    </div>
  <% end %>

  <section class="assigned-keywords">
    <div class="section-heading">
      <h2>現在のお題</h2>
      <%= button_to "ランダムで1つ追加",
            add_random_keyword_admin_kukai_path(@kukai),
            method: :post,
            class: "secondary-button" %>
    </div>

    <% if @kukai.keywords.any? %>
      <div class="keyword-chips readonly">
        <% @kukai.keywords.order(:word).each do |keyword| %>
          <span class="keyword-chip-with-action">
            <%= keyword.word %>
            <%= button_to "外す",
                  keyword_admin_kukai_path(@kukai, keyword),
                  method: :delete,
                  data: { turbo_confirm: "このお題を句会から外しますか？" },
                  class: "chip-button" %>
          </span>
        <% end %>
      </div>
    <% else %>
      <p class="muted-text">まだお題が割り当てられていません。</p>
    <% end %>
  </section>

  <section class="assigned-keywords">
    <div class="section-heading">
      <h2>お題を検索して追加</h2>
    </div>

    <%= form_with url: edit_admin_kukai_path(@kukai), method: :get, class: "auth-form" do %>
      <div class="form-row">
        <%= label_tag :keyword_q, "お題検索" %>
        <%= search_field_tag :keyword_q, @keyword_query, placeholder: "語句・読み・カテゴリで検索" %>
      </div>

      <div class="form-actions">
        <%= submit_tag "検索する", class: "secondary-button" %>
      </div>
    <% end %>

    <% if @keyword_candidates.any? %>
      <div class="keyword-candidate-list">
        <% @keyword_candidates.each do |keyword| %>
          <div class="keyword-candidate">
            <div>
              <strong><%= keyword.word %></strong>
              <span><%= [keyword.reading, keyword.pos, keyword.category].compact_blank.join(" / ") %></span>
            </div>
            <%= button_to "追加",
                  add_keyword_admin_kukai_path(@kukai),
                  params: { keyword_id: keyword.id },
                  method: :post,
                  class: "secondary-button" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="muted-text">追加できるお題が見つかりません。</p>
    <% end %>
  </section>
</section>
