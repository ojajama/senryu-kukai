<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} - 川柳句会" : "川柳句会" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#193f45">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="川柳句会">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <div class="site-nav">
        <%= link_to "川柳句会", root_path, class: "site-brand" %>

        <details class="nav-menu" open data-controller="nav-menu">
          <summary>メニュー</summary>
          <nav>
            <%= link_to "ホーム", root_path %>
            <%= link_to "句会一覧", kukais_path %>
            <%= link_to "いいねランキング", ranking_path %>
            <%= link_to "お題一覧", keywords_path %>
            <%= link_to "参加者一覧", users_path %>

            <% if user_signed_in? %>
              <hr class="nav-divider">
              <span class="nav-user">ログイン中：<%= current_user.display_name %></span>
              <%= link_to "アカウント設定", edit_user_registration_path, class: "nav-user-action" %>
              <% if current_user.admin? %>
                <%= link_to "お題管理", admin_keywords_path, class: "nav-user-action" %>
                <%= link_to "句会管理", admin_kukais_path, class: "nav-user-action" %>
                <%= link_to "招待管理", admin_invitations_path, class: "nav-user-action" %>
                <%= link_to "ユーザー管理", admin_users_path, class: "nav-user-action" %>
              <% end %>
              <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "nav-user-action" %>
            <% else %>
              <hr class="nav-divider">
              <%= link_to "新規登録", new_user_registration_path %>
              <%= link_to "ログイン", new_user_session_path %>
            <% end %>
          </nav>
        </details>
      </div>
    </header>

    <div id="flash_message" role="status" aria-live="polite">
        <% if notice.present? %>
          <p><%= notice %></p>
        <% end %>

        <% if alert.present? %>
          <p><%= alert %></p>
        <% end %>
    </div>

    <div id="page-announcer"
         role="status"
         aria-live="polite"
         aria-atomic="true"
         class="sr-only"
         data-controller="page-announcer"></div>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
