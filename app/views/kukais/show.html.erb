<section class="kukai-header">
  <h1 class="kukai-title"><%= @kukai.title %></h1>

  </section>

  <section class="post-form-box">

  <div id="post_form">
    <%= render "posts/form",
          post: Post.new,
          kukai: @kukai,
          keywords: @keywords %>
  </div>

  </section>

<h2>新着投稿</h2>

<div id="posts">
  <% if @posts.any? %>
    <%= render @posts %>
  <% else %>
    <p id="no_posts">まだ投稿がありません。</p>
  <% end %>
</div>
