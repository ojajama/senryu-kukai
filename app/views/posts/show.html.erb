<% content_for :title, @post.verse %>

<p class="back-link">
  <%= link_to "句会に戻る", kukai_path(@post.kukai) %>
</p>

<article class="post-detail">
  <div class="post-meta-line">
    <span class="post-keyword"><%= @post.keyword.word %></span>
    <span><%= l @post.created_at, format: :short %></span>
  </div>

  <div class="post-verse">
    <%= simple_format(h(@post.verse)) %>
  </div>

  <p class="post-author">
    投稿者：<%= link_to @post.user.display_name, user_posts_path(@post.user) %>
  </p>

  <%= render "posts/like_button", post: @post %>

  <% if user_signed_in? && @post.user == current_user %>
    <div class="post-actions">
      <%= link_to "編集", edit_post_path(@post) %>
      <%= button_to "削除", post_path(@post),
            method: :delete,
            data: { turbo_confirm: "本当に削除しますか？" } %>
    </div>
  <% end %>

  <section class="post-detail-comments">
    <h2>コメント</h2>
    <%= render "posts/comments_block", post: @post %>
  </section>

  <section class="post-detail-revisions">
    <h2>推敲履歴</h2>
    <%= render "posts/revision_summary", post: @post %>
  </section>
</article>
