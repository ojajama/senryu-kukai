<% content_for :title, "お題管理" %>
<section class="page-header">
  <h1>お題管理</h1>
  <p>登録済みのお題を確認・編集できます。</p>
</section>

<div class="admin-summary with-actions">
  <span>登録 <%= @keywords.size %>件</span>
  <details class="csv-import-box">
    <summary>CSVで一括登録</summary>
    <div class="csv-import-form">
      <p class="csv-import-note">列順：<code>word, reading, pos, sub_pos, category, sub_cate, len</code>（1行目はヘッダー）。既存のwordはスキップ。BOM付きUTF-8可。</p>
      <%= form_with url: import_admin_keywords_path, multipart: true do |f| %>
        <div class="csv-import-row">
          <%= f.file_field :file, accept: ".csv", aria: { label: "CSVファイルを選択" } %>
          <%= f.submit "インポート", class: "primary-button" %>
        </div>
      <% end %>
    </div>
  </details>
</div>

<div class="admin-table-wrap">
  <table class="admin-table" data-controller="table-sort">
    <thead>
      <tr>
        <th class="sortable" data-action="click->table-sort#sort">表記</th>
        <th class="sortable" data-action="click->table-sort#sort">読み</th>
        <th class="sortable" data-action="click->table-sort#sort">品詞</th>
        <th class="sortable" data-action="click->table-sort#sort">品詞細分</th>
        <th class="sortable" data-action="click->table-sort#sort">カテゴリ</th>
        <th class="sortable" data-action="click->table-sort#sort">カテゴリ細分</th>
        <th class="sortable" data-action="click->table-sort#sort">音数</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @keywords.each do |keyword| %>
        <tr>
          <td><%= keyword.word %></td>
          <td><%= keyword.reading %></td>
          <td><%= keyword.pos %></td>
          <td><%= keyword.sub_pos %></td>
          <td><%= keyword.category %></td>
          <td><%= keyword.sub_cate %></td>
          <td><%= keyword.len %></td>
          <td><%= link_to "編集", edit_admin_keyword_path(keyword) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
