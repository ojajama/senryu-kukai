<h1><%= @kukai.title %></h1>

<h2>お題</h2>
  <ul>
    <% @keywords.each do |k| %>
      <li><%= link_to k.word, kukai_keyword_path(@kukai, k) %></li>
    <% end %>
  </ul>

<h2>投稿する</h2>

<div id="post_form">
  <%= render "posts/form",
        post: Post.new,
        kukai: @kukai,
        keywords: @keywords %>
</div>

<h2>新着投稿</h2>

<div id="posts">
  <% if @posts.any? %>
    <%= render @posts %>
  <% else %>
    <p id="no_posts">まだ投稿がありません。</p>
  <% end %>
</div>
