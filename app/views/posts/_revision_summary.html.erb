<div id="post_revision_summary_<%= post.id %>">
  <% if post.post_revisions.any? %>
    <div class="revision-links">
      <span>推敲 <%= post.post_revisions.size %>回</span>
      <%= link_to "推敲履歴を見る",
          post_revision_path(post.post_revisions.order(created_at: :desc).first) %>

      <%= link_to "推敲の流れを見る",
          post_post_revisions_path(post) %>
    </div>
  <% else %>
    <p class="muted-text">推敲履歴はまだありません。</p>
  <% end %>
</div>
