<% content_for :title, @kukai.title %>
<p class="back-link"><%= link_to "句会一覧に戻る", kukais_path %></p>
<section class="kukai-header">
  <p class="kukai-month"><%= @kukai.year %>年<%= @kukai.month %>月の句会</p>
  <h1 class="kukai-title"><%= @kukai.title %></h1>

  <div class="kukai-stats">
    <span>投稿 <%= @posts.size %>句</span>
    <span>お題 <%= @keywords.size %>件</span>
    <%= link_to "いいねランキング", ranking_kukai_path(@kukai), class: "ranking-link" %>
  </div>
</section>

<% if @kukai.selecting? %>
  <section class="selection-banner" aria-label="選句期間">
    <p class="selection-banner-title">選句期間中です</p>
    <% if user_signed_in? %>
      <p id="selection-count" class="selection-count"
         aria-live="polite" aria-atomic="true">
        <%= @my_selection_count.to_i %> / 3 句選択済み
      </p>
      <p class="selection-hint">好きな句を3句まで選んでください。作者は結果発表まで伏せられています。</p>
    <% else %>
      <p><%= link_to "ログイン", new_user_session_path %>すると選句できます。</p>
    <% end %>
  </section>
<% elsif @kukai.revealed? %>
  <section class="selection-banner selection-banner--revealed" aria-label="句会終了">
    <p class="selection-banner-title">この句会は終了しました</p>
    <p class="selection-hint">選句結果は各投稿に表示されています。</p>
  </section>
<% end %>

<% unless @kukai.selecting? || @kukai.revealed? %>
  <section class="post-form-box">
    <div class="section-heading">
      <h2>一句投稿する</h2>
    </div>

    <% if user_signed_in? %>
      <div id="post_form">
        <%= render "posts/form",
              post: Post.new,
              kukai: @kukai,
              keywords: @keywords %>
      </div>
    <% else %>
      <p class="signin-prompt">
        投稿するには<%= link_to "ログイン", new_user_session_path %>してください。
      </p>
    <% end %>
  </section>
<% end %>

<div class="section-heading posts-heading">
  <h2>
    <% if @kukai.selecting? %>選句中の投稿
    <% elsif @kukai.revealed? %>結果発表
    <% else %>新着投稿
    <% end %>
  </h2>
</div>

<div id="posts" class="posts-list">
  <% if @posts.any? %>
    <% if @kukai.selecting? || @kukai.revealed? %>
      <%= render @posts, kukai: @kukai, my_selections: @my_selections || {} %>
    <% else %>
      <%= render partial: "posts/post_row", collection: @posts, as: :post,
            locals: { kukai: @kukai } %>
    <% end %>
  <% else %>
    <p id="no_posts">まだ投稿がありません。</p>
  <% end %>
</div>
