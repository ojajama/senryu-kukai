<h1>推敲の差分</h1>

<p>
  <%= link_to "句会に戻る", kukai_path(@revision.post.kukai) %>
</p>

<section>
  <h3>変更前</h3>
  <%= simple_format(h(@revision.before_verse)) %>
  <%= button_to "変更前に戻す",
      restore_post_revision_path(@revision),
      method: :patch,
      params: { target: "before" } %>
</section>

<section>
  <h3>変更後</h3>
  <%= simple_format(h(@revision.after_verse)) %>
  <%= button_to "変更後に戻す",
      restore_post_revision_path(@revision),
      method: :patch,
      params: { target: "after" } %>
</section>

<section>
  <h3>差分</h3>

  <%= raw Diffy::Diff.new(
        @revision.before_verse.to_s,
        @revision.after_verse.to_s
      ).to_s(:html) %>
</section>

