<% if user_signed_in? %>
  <%= turbo_frame_tag "like_post_#{post.id}" do %>
    <% like = current_user.likes.find_by(post: post) %>

    <p role="status" aria-live="polite">
      いいね、現在 <%= post.likes.count %> 件
    </p>

    <% if like %>
      <%= button_to "いいねを取り消す",
            post_like_path(post, like),
            method: :delete %>
    <% else %>
      <%= button_to "いいね",
            post_likes_path(post),
            method: :post %>
    <% end %>
  <% end %>
<% end %>