<h1>推敲の差分</h1>

<p>
  <%= link_to "この投稿に戻る", kukai_path(@revision.post.kukai, anchor: dom_id(@revision.post)) %>
  ／
  <%= link_to "句会に戻る", kukai_path(@revision.post.kukai) %>
</p>

<section>
  <h3>推敲前</h3>
  <%= simple_format(h(@revision.before_verse)) %>
  <%= button_to "推敲前に戻す",
      restore_post_revision_path(@revision),
      method: :patch,
      params: { target: "before" } %>
</section>

<section>
  <h3>推敲後</h3>
  <%= simple_format(h(@revision.after_verse)) %>
  <%= button_to "推敲後に戻す",
      restore_post_revision_path(@revision),
      method: :patch,
      params: { target: "after" } %>
</section>

<section aria-hidden="true">
  <h3>差分</h3>

  <%= raw Diffy::Diff.new(
        @revision.before_verse.to_s,
        @revision.after_verse.to_s
      ).to_s(:html) %>
</section>

    <%= button_to @revision.ai_comment.present? ? "AI講評を再表示する" : "AIにコメントさせる",
      ai_comment_post_revision_path(@revision),
      method: :post,
      data: { turbo_frame: "ai_comment_#{@revision.id}" } %>

      <%= turbo_frame_tag "ai_comment_#{@revision.id}" do %>
        <% if @revision.ai_comment.present? %>
          <div role="status" aria-live="polite" class="ai-comment">
            <h3>AI講評</h3>
            <%= simple_format(h(@revision.ai_comment)) %>
          </div>
        <% end %>
      <% end %>
