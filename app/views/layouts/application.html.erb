<!DOCTYPE html>
<html>
  <head>
    <title>SenryuKukai</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <nav>
        <%= link_to "ホーム", root_path %>
        <%= link_to "句会一覧", kukais_path %>
        <%= link_to "お題一覧", keywords_path %>
        <%= link_to "参加者一覧", users_path %>

        <% if user_signed_in? %>
          <span>ログイン中：<%= current_user.display_name %></span>
          <%= link_to "アカウント設定", edit_user_registration_path %>
          <% if current_user.admin? %>
            <%= link_to "お題管理", admin_keywords_path %>
          <% end %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete %>
        <% else %>
          <%= link_to "新規登録", new_user_registration_path %>
          <%= link_to "ログイン", new_user_session_path %>
        <% end %>
      </nav>
    </header>

    <div id="flash_message" role="status" aria-live="polite">
        <% if notice.present? %>
          <p><%= notice %></p>
        <% end %>

        <% if alert.present? %>
          <p><%= alert %></p>
        <% end %>
    </div>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
