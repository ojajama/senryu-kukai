<h1>投稿を編集</h1>

<%= form_with model: @post, local: true do |f| %>
  <div>
    <%= f.label :keyword_id, "お題" %><br>
    <%= f.collection_select :keyword_id, @post.kukai.keywords, :id, :word %>
  </div>

  <div>
    <%= f.label :verse, "川柳" %><br>
    <%= f.text_field :verse %>
  </div>

  <div>
    <%= f.submit "更新する" %>
  </div>
<% end %>

<h2>推敲履歴</h2>

<% if @post.post_revisions.any? %>
  <ul>
    <% @post.post_revisions.order(created_at: :desc).each do |r| %>
      <li>
        <%= r.after_verse %><br>
        <small>投稿日：<%= l r.created_at, format: :short %></small>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>推敲履歴はありません。</p>
<% end %>

<p>
  <%= link_to "句会に戻る", kukai_path(@post.kukai) %>
</p>