<article id="<%= dom_id(post) if post.persisted? %>">

  <%= form_with model: post, local: true do |f| %>
    <div class="current-keyword">
        <p class="form-label">お題を選ぶ</p>

        <div class="keyword-chips">
          <% keywords.each do |k| %>
            <label class="keyword-chip">
              <%= f.radio_button :keyword_id, k.id %>
              <span><%= k.word %></span>
            </label>
          <% end %>
        </div>
    </div>

    <div class="form-row">
      <%= f.label :verse, "川柳" %>
      <%= f.text_area :verse, rows: 3 %>
    </div>

    <div>
      <%= f.submit post.persisted? ? "更新する" : "投稿する", class: "primary-button" %>
    </div>
  <% end %>

</article>