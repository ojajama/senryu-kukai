<section class="auth-panel">
  <div class="section-heading">
    <h1>新しいパスワードを設定する</h1>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="form-row">
      <%= f.label :password, "新しいパスワード" %>
      <% if @minimum_password_length %>
        <p class="form-hint"><%= @minimum_password_length %>文字以上で入力してください。</p>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %>
    </div>

    <div class="form-row">
      <%= f.label :password_confirmation, "新しいパスワード確認" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="form-actions">
      <%= f.submit "パスワードを変更する", class: "primary-button" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
