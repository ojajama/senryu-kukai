<% if @post.persisted? %>
  <%= turbo_stream.remove "no_posts" %>
  <%= turbo_stream.prepend "posts",
        partial: "posts/post_row",
        locals: { post: @post, kukai: @kukai } %>
<% end %>
      
<%= turbo_stream.replace "post_form" do %>
  <div id="post_form">
    <% unless @post.persisted? %>
      <p class="form-errors compact" role="alert"><%= @post_error_message %></p>
    <% end %>
    <%= render "posts/form",
          post: @post.persisted? ? Post.new : @post,
          kukai: @kukai,
          keywords: @keywords %>
  </div>
<% end %>

<%= turbo_stream.replace "flash_message" do %>
  <div id="flash_message" role="status" aria-live="polite">
    <% if @post.persisted? %>
      <p>投稿しました。</p>
    <% end %>
  </div>
<% end %>
