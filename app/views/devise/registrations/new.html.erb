<section class="auth-panel">
  <div class="section-heading">
    <h1>新規登録</h1>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-row">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="form-row">
      <%= f.label :nickname, "ニックネーム" %>
      <p class="form-hint">投稿者名として表示されます。あとから変更できます。</p>
      <%= f.text_field :nickname, autocomplete: "nickname" %>
    </div>

    <div class="form-row">
      <%= f.label :password, "パスワード" %>
      <% if @minimum_password_length %>
        <p class="form-hint"><%= @minimum_password_length %>文字以上で入力してください。</p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password" %>
    </div>

    <div class="form-row">
      <%= f.label :password_confirmation, "パスワード確認" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="form-actions">
      <%= f.submit "登録する", class: "primary-button" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
