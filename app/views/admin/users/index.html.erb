<% content_for :title, "ユーザー管理" %>
<section class="page-header">
  <h1>ユーザー管理</h1>
  <p>ニックネームやパスワードの変更など、友人のアカウントをサポートできます。</p>
</section>

<div class="admin-summary">
  <span>登録ユーザー <%= @users.count %>人</span>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>ニックネーム</th>
        <th>メールアドレス</th>
        <th>登録日</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <%= user.nickname %>
            <% if user.admin? %><span class="admin-badge">管理者</span><% end %>
          </td>
          <td><%= user.email %></td>
          <td><%= user.created_at.strftime("%Y/%m/%d") %></td>
          <td><%= link_to "編集", edit_admin_user_path(user), class: "table-action-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
