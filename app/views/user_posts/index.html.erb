<h1><%= @user.email %>さんの投稿</h1>

<% if @posts.any? %>
  <ul>
    <% @posts.each do |p| %>
      <li>
        <strong><%= p.keyword.word %></strong><br>
        <%= p.verse %><br>
        句会：<%= p.kukai.title %>
        投稿日：<%= l p.created_at, format: :short %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだ投稿がありません。</p>
<% end %>