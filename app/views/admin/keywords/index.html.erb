<% content_for :title, "お題管理" %>
<section class="page-header">
  <h1>お題管理</h1>
  <p>登録済みのお題を確認・編集できます。</p>
</section>

<div class="admin-summary">
  <span>登録 <%= @keywords.size %>件</span>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>表記</th>
        <th>読み</th>
        <th>品詞</th>
        <th>品詞細分</th>
        <th>カテゴリ</th>
        <th>カテゴリ細分</th>
        <th>音数</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @keywords.each do |keyword| %>
        <tr>
          <td><%= keyword.word %></td>
          <td><%= keyword.reading %></td>
          <td><%= keyword.pos %></td>
          <td><%= keyword.sub_pos %></td>
          <td><%= keyword.category %></td>
          <td><%= keyword.sub_cate %></td>
          <td><%= keyword.len %></td>
          <td><%= link_to "編集", edit_admin_keyword_path(keyword) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
