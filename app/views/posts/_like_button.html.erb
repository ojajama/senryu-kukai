<% if user_signed_in? %>
  <%= turbo_frame_tag "like_post_#{post.id}" do %>
    <% like = current_user.likes.find_by(post: post) %>

    <div class="like-row" role="status" aria-live="polite">
      <span>いいね <%= post.likes.count %>件</span>

      <% if like %>
        <%= button_to "取り消す",
              post_like_path(post, like),
              method: :delete,
              class: "secondary-button" %>
      <% else %>
        <%= button_to "いいね",
              post_likes_path(post),
              method: :post,
              class: "secondary-button" %>
      <% end %>
    </div>
  <% end %>
<% end %>
