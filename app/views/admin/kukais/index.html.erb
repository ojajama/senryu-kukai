<% content_for :title, "句会管理" %>
<section class="page-header">
  <h1>句会管理</h1>
  <p>月ごとの句会と、お題数・投稿数を確認できます。</p>
</section>

<div class="admin-summary with-actions">
  <span>登録済み句会 <%= @kukais.length %>回</span>
  <%= link_to "新しい句会を作成", new_admin_kukai_path, class: "primary-link-button" %>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>年月</th>
        <th>タイトル</th>
        <th></th>
        <th>表示</th>
        <th>お題</th>
        <th>投稿</th>
      </tr>
    </thead>
    <tbody>
      <% @kukais.each do |kukai| %>
        <tr>
          <td><%= kukai.year %>年<%= kukai.month %>月</td>
          <td><%= kukai.title %></td>
          <td>
            <div class="table-actions">
              <%= link_to "編集", edit_admin_kukai_path(kukai) %>
              <%= link_to "公開ページ", kukai_path(kukai) %>
            </div>
          </td>
          <td><%= kukai.visible? ? "表示" : "非表示" %></td>
          <td>
            <div class="status-actions">
              <span class="kukai-status kukai-status--<%= kukai.status %>">
                <%= { "posting" => "投稿中", "selecting" => "選句中", "revealed" => "発表済" }[kukai.status] %>
              </span>
              <% if kukai.posting? %>
                <%= button_to "選句開始",
                      start_selection_admin_kukai_path(kukai),
                      class: "secondary-button status-button",
                      data: { turbo_confirm: "「#{kukai.title}」の選句期間を開始します。新規投稿を締め切り、作者が伏せられます。よろしいですか？" } %>
              <% elsif kukai.selecting? %>
                <%= button_to "結果発表",
                      reveal_admin_kukai_path(kukai),
                      class: "primary-button status-button",
                      data: { turbo_confirm: "「#{kukai.title}」の選句結果を発表します。作者が公開されます。よろしいですか？" } %>
              <% end %>
            </div>
          </td>
          <td><%= kukai.keywords_count %>件</td>
          <td><%= kukai.posts_count %>句</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
