<% content_for :title, "投稿を編集" %>
<h1>投稿を編集</h1>

<%= render "form",
      post: @post,
      kukai: @post.kukai,
      keywords: @keywords,
      turbo: false %>

<section class="post-detail-revisions">
  <h2>推敲履歴</h2>
  <%= render "posts/revision_summary", post: @post %>
</section>

<p>
  <%= link_to "句会に戻る", kukai_path(@post.kukai) %>
</p>