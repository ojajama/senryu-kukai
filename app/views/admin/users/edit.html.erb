<% content_for :title, "ユーザー編集" %>
<section class="page-header">
  <h1><%= @user.nickname %> さんの情報を変更</h1>
  <p>メールアドレス：<%= @user.email %></p>
</section>

<div class="admin-form-section">
  <%= form_with model: [:admin, @user], local: true do |f| %>
    <% if @user.errors.any? %>
      <div class="form-errors" role="alert">
        <% @user.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :nickname, "ニックネーム" %>
      <%= f.text_field :nickname, value: @user.nickname, autocomplete: "off" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワードを変更する（変更しない場合は空欄）" %>
      <%= f.text_field :password, placeholder: "例：1234", autocomplete: "off",
            inputmode: "numeric", data: { normalize: "numeric" } %>
    </div>

    <%= f.submit "更新する", class: "primary-link-button" %>
    <%= link_to "戻る", admin_users_path, class: "secondary-link-button" %>
  <% end %>
</div>

<script>
  document.querySelectorAll("[data-normalize='numeric']").forEach(function(input) {
    input.addEventListener("input", function() {
      input.value = input.value.replace(/[０-９]/g, function(ch) {
        return String.fromCharCode(ch.charCodeAt(0) - 0xFEE0);
      });
    });
  });
</script>
