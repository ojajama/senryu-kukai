<h1><%= @kukai.title %></h1>

<h2>お題:<%= @keyword.word %></h2>

<p><%=link_to "句会に戻る", kukai_path(@kukai) %></p>

<h3>投稿一覧</h3>

<% if @posts.any? %>
  <ul>
    <% @posts.each do |p| %>
      <li>
        <%= p.verse %><br>
        投稿者：<%= link_to p.user.email, user_posts_path(p.user) %><br>
        投稿日：<%= l p.created_at, format: :short %>

        <% if user_signed_in? && p.user == current_user %>
        <p>
          <%= link_to "編集", edit_post_path(p) %>
          <%= button_to "削除",
                post_path(p),
                method: :delete,
                data: { turbo_confirm: "本当に削除しますか？" } %>
        </p>
        <% end %>

        <p>いいね：<%= p.likes.count %>件</p>

          <% if user_signed_in? %>
            <% like = current_user.likes.find_by(post: p) %>

            <% if like %>
              <%= button_to "いいねを取り消す", post_like_path(p, like), method: :delete %>
            <% else %>
              <%= button_to "いいね", post_likes_path(p), method: :post %>
            <% end %>
          <% end %>

          <h4>コメント</h4>

          <% p.comments.order(created_at: :asc).each do |c| %>
            <p>
              <%= c.body %><br>
              <small>
                <%= c.user.email %>・<%= l c.created_at, format: :short %>
              </small>
            </p>
          <% end %>

          <% if user_signed_in? %>
            <%= form_with model: [p, Comment.new] do |f| %>
              <%= f.text_area :body %><br>
              <%= f.submit "コメントする" %>
            <% end %>
          <% end %>

      </li>
    <% end %>
  </ul>
<% else %>
  <p>このお題には、まだ投稿がありません。</p>
<% end %>