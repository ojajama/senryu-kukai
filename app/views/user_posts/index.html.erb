<h1><%= @user.email %>さんの投稿</h1>

<% if @posts.any? %>
  <ul>
    <% @posts.each do |p| %>
      <li>
        <strong><%= p.keyword.word %></strong><br>
        <%= p.verse %><br>
        句会：<%= p.kukai.title %>
        投稿日：<%= l p.created_at, format: :short %>

        <p>いいね：<%= p.likes.count %>件</p>

          <% if user_signed_in? %>
            <% like = current_user.likes.find_by(post: p) %>

            <% if like %>
              <%= button_to "いいねを取り消す", post_like_path(p, like), method: :delete %>
            <% else %>
              <%= button_to "いいね", post_likes_path(p), method: :post %>
            <% end %>
          <% end %>

          <h4>コメント</h4>

          <% p.comments.order(created_at: :asc).each do |c| %>
            <p>
              <%= c.body %><br>
              <small>
                <%= c.user.email %>・<%= l c.created_at, format: :short %>
              </small>
            </p>
          <% end %>

          <% if user_signed_in? %>
            <%= form_with model: [p, Comment.new] do |f| %>
              <%= f.text_area :body %><br>
              <%= f.submit "コメントする" %>
            <% end %>
          <% end %>

      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだ投稿がありません。</p>
<% end %>