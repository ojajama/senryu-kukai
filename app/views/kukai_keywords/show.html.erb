<h1><%= @kukai.title %></h1>

<h2>お題:<%= @keyword.word %></h2>

<p><%=link_to "句会に戻る", kukai_path(@kukai) %></p>

<h3>投稿一覧</h3>

<% if @posts.any? %>
  <ul>
    <% @posts.each do |p| %>
      <li>
        <%= p.verse %><br>
        投稿者：<%= link_to p.user.email, user_posts_path(p.user) %><br>
        投稿日：<%= l p.created_at, format: :short %>
        <p>いいね：<%= p.likes.count %>件</p>

          <% if user_signed_in? %>
            <% like = current_user.likes.find_by(post: p) %>

            <% if like %>
              <%= button_to "いいねを取り消す", post_like_path(p, like), method: :delete %>
            <% else %>
              <%= button_to "いいね", post_likes_path(p), method: :post %>
            <% end %>
          <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>このお題には、まだ投稿がありません。</p>
<% end %>