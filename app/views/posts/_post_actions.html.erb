  <% if user_signed_in? && post.user == current_user %>
    <p>
      <%= link_to "編集", edit_post_path(post), data: { turbo_frame: true } %>

      <%= button_to "削除",
            post_path(post),
            method: :delete,
            data: { turbo_confirm: "本当に削除しますか？" } %>
    </p>
  <% end %>
