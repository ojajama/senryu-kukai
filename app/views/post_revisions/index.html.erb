<h1>推敲の流れ</h1>

<p>
  <%= link_to "句会に戻る", kukai_path(@post.kukai) %>
</p>

<p>
  現在の句：
</p>

<%= simple_format(h(@post.verse)) %>

<hr>

<% @revisions.each_with_index do |rev, i| %>
  <section style="margin: 1.5em 0;">
    <h2>
      <%= i + 1 %>回目の推敲
      <small><%= rev.created_at.strftime("%Y-%m-%d %H:%M") %></small>
    </h2>

    <p>
      <%= link_to "この差分を見る", post_revision_path(rev) %>
    </p>

    <h3>推敲前</h3>
    <%= simple_format(h(rev.before_verse)) %>

    <h3>推敲後</h3>
    <%= simple_format(h(rev.after_verse)) %>

    <%= button_to "AIにコメントさせる",
      ai_comment_post_revision_path(rev),
      method: :post,
      data: { turbo_frame: "ai_comment_#{rev.id}" } %>

      <%= turbo_frame_tag "ai_comment_#{rev.id}" do %>
      <% end %>
  </section>

  <hr>
<% end %>
