<h1>川柳句会</h1>
<% if user_signed_in? %>
  <p>ようこそ、<%= current_user.email %> さん！</p>
  <%= button_to "ログアウト", destroy_user_session_path, method: :delete %>
<% else %>
  <p>川柳句会へようこそ！</p>
  <%= link_to "新規登録", new_user_registration_path %> |
  <%= link_to "ログイン", new_user_session_path %>
<% end %>

<% if @current_kukai.present? %>
  <p>
    <%= link_to "今月の句会へ", kukai_path(@current_kukai) %>（<%= @current_kukai.year %>年<%= @current_kukai.month %>月）
  </p>
<% else %>
  <p>現在開催中の川柳句会はありません。</p>
<% end %>