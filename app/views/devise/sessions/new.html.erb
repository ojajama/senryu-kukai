<section class="auth-panel">
  <div class="section-heading">
    <h1>ログイン</h1>
  </div>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
    <div class="form-row">
      <%= f.label :login, "メールアドレスまたはニックネーム" %>
      <%= f.text_field :login, autofocus: true, autocomplete: "username" %>
    </div>

    <div class="form-row">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="checkbox-row">
        <%= f.check_box :remember_me %>
        <span>ログイン状態を保持する</span>
      </label>
    <% end %>

    <div class="form-actions">
      <%= f.submit "ログイン", class: "primary-button" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
