<%= form_with model: [kukai, post], local: true do |f| %>
  <div>
    <%= f.label :keyword_id, "お題" %>
    <%= f.collection_select :keyword_id,
          keywords,
          :id,
          :word,
          prompt: "選択してください" %>
  </div>

  <div>
    <%= f.label :verse, "川柳" %>
    <%= f.text_field :verse %>
  </div>

  <div>
    <%= f.submit "投稿する" %>
  </div>
<% end %>
