<article id="<%= dom_id(post) %>" class="post-card" tabindex="-1">

<%= render "posts/post_body", post: post %>

<%= render "posts/like_button", post: post %>

<%= render "posts/post_actions", post: post %>

<details class="post-extra">
  <summary>コメントや推敲履歴を見る</summary>

  <%= render "posts/comments_block", post: post %>
  <%= render "posts/revision_summary", post: post %>
</details>

</article>